@page "/admin/statistics"
@layout AdminLayout
@using Frontend.Services
@using Frontend.Models.Order.Responses
@using Frontend.Models.OrderItem.Responses
@using Frontend.Models.Common
@using Frontend.Models
@using Microsoft.JSInterop
@inject OrderService OrderService
@inject OrderItemService OrderItemService
@inject ProductService ProductService
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="admin-page">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2>Thống kê & Báo cáo</h2>
                <p class="text-muted">Phân tích dữ liệu và xuất báo cáo hệ thống</p>
            </div>
            <div class="export-buttons">
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="exportDropdown">
                        <i class="bi bi-download"></i> Xuất báo cáo
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="exportDropdown">
                        <li><a class="dropdown-item" href="javascript:void(0)" @onclick="ExportToPDF" @onclick:preventDefault="true">
                            <i class="bi bi-file-pdf text-danger"></i> Xuất PDF
                        </a></li>
                        <li><a class="dropdown-item" href="javascript:void(0)" @onclick="ExportToExcel" @onclick:preventDefault="true">
                            <i class="bi bi-file-excel text-success"></i> Xuất Excel
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    
    <div class="stats-filters">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label"><i class="bi bi-calendar-event"></i> Từ ngày</label>
                <input type="date" class="form-control" @bind="fromDate" @bind:event="onchange" />
            </div>
            <div class="col-md-3">
                <label class="form-label"><i class="bi bi-calendar-check"></i> Đến ngày</label>
                <input type="date" class="form-control" @bind="toDate" @bind:event="onchange" />
            </div>
            <div class="col-md-3">
                <label class="form-label"><i class="bi bi-funnel"></i> Loại báo cáo</label>
                <select class="form-select" value="@reportType" @onchange="OnReportTypeChanged">
                    <option value="revenue">Doanh thu</option>
                    <option value="orders">Đơn hàng</option>
                    <option value="products">Sản phẩm</option>
                    <option value="customers">Khách hàng</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary w-100" @onclick="LoadStatistics">
                    <i class="bi bi-search"></i> Tạo báo cáo
                </button>
            </div>
        </div>
    </div>
    
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <p class="mt-3 text-muted">Đang tải dữ liệu thống kê...</p>
        </div>
    }
    else
    {
        <div class="stats-content">
            <!-- Summary Cards -->
            <div class="row mb-4">
                                <div class="col-md-3">
                                    <div class="stat-card revenue-card">
                                        <div class="stat-icon">
                                            <i class="bi bi-currency-dollar"></i>
                                        </div>
                                        <div class="stat-info">
                                            <h6>@GetSummaryLabel("total")</h6>
                                            <h3>@FormatPrice(totalRevenue)</h3>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-card orders-card">
                                        <div class="stat-icon">
                                            <i class="bi bi-cart-check"></i>
                                        </div>
                                        <div class="stat-info">
                                            <h6>Tổng đơn hàng</h6>
                                            <h3>@totalOrdersCount</h3>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-card average-card">
                                        <div class="stat-icon">
                                            <i class="bi bi-graph-up"></i>
                                        </div>
                                        <div class="stat-info">
                                            <h6>@GetSummaryLabel("average")</h6>
                                            <h3>@FormatPrice(averageOrderValue)</h3>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-card products-card">
                                        <div class="stat-icon">
                                            <i class="bi bi-box-seam"></i>
                                        </div>
                                        <div class="stat-info">
                                            <h6>Sản phẩm đã bán</h6>
                                            <h3>@totalProductsSold</h3>
                                        </div>
                                    </div>
                                </div>
            </div>

            <!-- Revenue Chart -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card chart-card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="bi bi-bar-chart-fill"></i> 
                                @GetChartTitle()
                            </h5>
                            <div class="chart-controls">
                                @if (reportType?.ToLower() == "revenue")
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleChartType">
                                        <i class="bi bi-arrow-repeat"></i> Đổi loại biểu đồ
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            @if (monthlyRevenue.Any())
                            {
                                <div class="chart-container" style="height: 400px; position: relative;">
                                    <canvas id="revenueChart"></canvas>
                                </div>
                            }
                            else
                            {
                                <div class="chart-placeholder">
                                    <i class="bi bi-bar-chart"></i>
                                    <p>Không có dữ liệu để hiển thị</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <!-- Top Products -->
                <div class="col-md-6 mb-4">
                    <div class="card chart-card">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-trophy-fill"></i> Top sản phẩm bán chạy</h5>
                        </div>
                        <div class="card-body">
                            @if (topProducts.Any())
                            {
                                <div class="chart-container" style="height: 350px; position: relative;">
                                    <canvas id="topProductsChart"></canvas>
                                </div>
                                <div class="top-products-list mt-3">
                                    @foreach (var product in topProducts.Take(10))
                                    {
                                        <div class="product-item">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="flex-grow-1">
                                                    <strong>@product.ProductName</strong>
                                                    <br />
                                                    <small class="text-muted">@FormatPrice(product.TotalRevenue)</small>
                                                </div>
                                                <span class="badge bg-primary rounded-pill">@product.QuantitySold</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <i class="bi bi-inbox display-4 text-muted"></i>
                                    <p class="text-muted mt-2">Không có dữ liệu</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                
                <!-- Order Status Distribution -->
                <div class="col-md-6 mb-4">
                    <div class="card chart-card">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-pie-chart-fill"></i> Phân bố đơn hàng theo trạng thái</h5>
                        </div>
                        <div class="card-body">
                            @if (orderStatusDistribution.Any())
                            {
                                <div class="chart-container" style="height: 350px; position: relative;">
                                    <canvas id="statusChart"></canvas>
                                </div>
                                <div class="status-legend mt-3">
                                    @foreach (var status in orderStatusDistribution)
                                    {
                                        var total = orderStatusDistribution.Sum(s => s.Count);
                                        var percentage = total > 0 ? (status.Count * 100.0 / total) : 0;
                                        <div class="status-item">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span>
                                                    <span class="status-dot @GetStatusColor(status.Status)"></span>
                                                    @GetStatusDisplayName(status.Status)
                                                </span>
                                                <span><strong>@status.Count</strong> (@percentage.ToString("F1")%)</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="chart-placeholder">
                                    <i class="bi bi-pie-chart"></i>
                                    <p>Không có dữ liệu để hiển thị</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
