    }
    
    .stat-icon {
        width: 70px;
        height: 70px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
        flex-shrink: 0;
    }
    
    .revenue-card .stat-icon {
        background: #3498db;
    }
    
    .orders-card .stat-icon {
        background: #e74c3c;
    }
    
    .average-card .stat-icon {
        background: #2ecc71;
    }
    
    .products-card .stat-icon {
        background: #f39c12;
    }
    
    .stat-info h6 {
        margin: 0;
        color: #6c757d;
        font-size: 0.875rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }
    
    .stat-info h3 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
        color: #2c3e50;
    }
    
    .chart-card {
        border: none;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
