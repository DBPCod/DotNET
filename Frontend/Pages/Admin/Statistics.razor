        max-width: 1400px;
        margin-left: auto;
        margin-right: auto;
        padding: 1rem;
    }
    
    .page-header {
        margin-bottom: 2rem;
    }
    
    .page-header h2 {
        margin-bottom: 0.5rem;
        color: #2c3e50;
        font-weight: 700;
    }
    
    .stats-filters {
        background: #34495e;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
        color: white;
    }
    
    .stats-filters .form-label {
        color: white;
        font-weight: 500;
    }
    
    .stats-filters .form-control,
    .stats-filters .form-select {
        border: none;
        border-radius: 8px;
    }
    
    .stat-card {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: transform 0.2s, box-shadow 0.2s;
