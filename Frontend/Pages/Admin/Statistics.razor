</style>

@code {
    private bool isLoading = false;
    private DateTime? fromDate;
    private DateTime? toDate;
    private string reportType = "revenue";
    private bool useBarChart = true; // Toggle between bar and line chart
    
    private List<MonthlyRevenue> monthlyRevenue = new();
    private List<TopProduct> topProducts = new();
    private List<OrderStatusCount> orderStatusDistribution = new();
    private decimal totalRevenue = 0;
    private int totalOrdersCount = 0;
    private decimal averageOrderValue = 0;
    private int totalProductsSold = 0;

    protected override async Task OnInitializedAsync()
    {
        // Kiểm tra quyền ADMIN
        if (AuthService.CurrentUser?.Role != "ADMIN")
        {
            // Chỉ ADMIN mới được xem Thống kê
            NavigationManager.NavigateTo("/unauthorized", true);
            return;
        }
        
        // Set default date range to last 6 months
        toDate = DateTime.Now;
        fromDate = DateTime.Now.AddMonths(-6);
        await LoadStatistics();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || !isLoading)
        {
            await RenderCharts();
        }
    }

    private async Task LoadStatistics()
    {
        isLoading = true;
        StateHasChanged();
        
        try
        {
            // Load all orders in the date range
            var ordersResponse = await OrderService.GetOrdersAsync(
                page: 1,
                pageSize: 10000,
                fromDate: fromDate,
                toDate: toDate
            );

            if (ordersResponse?.StatusCode == 200 && ordersResponse.Data != null)
            {
                var orders = ordersResponse.Data.Orders ?? new();
                totalOrdersCount = ordersResponse.Data.Pagination?.TotalCount ?? orders.Count;
                
                // Nếu có nhiều hơn 10000 orders trong khoảng thời gian, load thêm
                if (ordersResponse.Data.Pagination != null && ordersResponse.Data.Pagination.TotalPages > 1)
                {
                    var allOrdersList = new List<OrderDto>(orders);
                    for (int page = 2; page <= ordersResponse.Data.Pagination.TotalPages; page++)
                    {
                        var nextPageResponse = await OrderService.GetOrdersAsync(
                            page: page,
                            pageSize: 10000,
                            fromDate: fromDate,
                            toDate: toDate
                        );
                        if (nextPageResponse?.StatusCode == 200 && nextPageResponse.Data?.Orders != null)
                        {
                            allOrdersList.AddRange(nextPageResponse.Data.Orders);
                        }
                    }
                    orders = allOrdersList;
                }

                // Xử lý theo loại báo cáo
                switch (reportType?.ToLower())
                {
                    case "revenue":
                        // Báo cáo doanh thu
                        monthlyRevenue = orders
                            .Where(o => o.Status?.ToLower() == "paid" && o.TotalAmount.HasValue)
                            .GroupBy(o => new { o.OrderDate.Year, o.OrderDate.Month })
                            .Select(g => new MonthlyRevenue
                            {
                                Month = $"{g.Key.Month:00}/{g.Key.Year}",
                                Revenue = g.Sum(o => o.TotalAmount ?? 0)
                            })
                            .OrderBy(x => x.Month)
                            .ToList();

                        totalRevenue = orders
                            .Where(o => o.Status?.ToLower() == "paid" && o.TotalAmount.HasValue)
                            .Sum(o => o.TotalAmount ?? 0);

                        var paidOrders = orders.Where(o => o.Status?.ToLower() == "paid" && o.TotalAmount.HasValue).ToList();
                        averageOrderValue = paidOrders.Any() ? paidOrders.Average(o => o.TotalAmount ?? 0) : 0;
                        break;

                    case "orders":
                        // Báo cáo đơn hàng - Thống kê theo số lượng đơn hàng
                        monthlyRevenue = orders
                            .GroupBy(o => new { o.OrderDate.Year, o.OrderDate.Month })
                            .Select(g => new MonthlyRevenue
                            {
                                Month = $"{g.Key.Month:00}/{g.Key.Year}",
                                Revenue = g.Count() // Sử dụng Revenue field để lưu số lượng đơn hàng
                            })
                            .OrderBy(x => x.Month)
                            .ToList();

                        totalRevenue = orders.Count; // Tổng số đơn hàng
                        averageOrderValue = monthlyRevenue.Any() ? monthlyRevenue.Average(m => m.Revenue) : 0; // Trung bình đơn hàng/tháng
                        break;

                    case "products":
                        // Báo cáo sản phẩm - Tập trung vào top products
                        monthlyRevenue = new List<MonthlyRevenue>(); // Không cần monthly cho products
                        totalRevenue = 0; // Sẽ tính từ top products
                        averageOrderValue = 0;
                        break;

                    case "customers":
                        // Báo cáo khách hàng - Thống kê theo khách hàng
                        var uniqueCustomers = orders.Where(o => o.CustomerId != null).Select(o => o.CustomerId).Distinct().Count();
                        monthlyRevenue = orders
                            .Where(o => o.CustomerId != null)
                            .GroupBy(o => new { o.OrderDate.Year, o.OrderDate.Month })
                            .Select(g => new MonthlyRevenue
                            {
                                Month = $"{g.Key.Month:00}/{g.Key.Year}",
                                Revenue = g.Select(o => o.CustomerId).Distinct().Count() // Số khách hàng mới mỗi tháng
                            })
                            .OrderBy(x => x.Month)
                            .ToList();

                        totalRevenue = uniqueCustomers; // Tổng số khách hàng
                        averageOrderValue = orders.Any() && uniqueCustomers > 0 ? (decimal)(orders.Count / (double)uniqueCustomers) : 0; // Đơn hàng trung bình/khách hàng
                        break;

                    default:
                        // Mặc định: Báo cáo doanh thu
                        monthlyRevenue = orders
                            .Where(o => o.Status?.ToLower() == "paid" && o.TotalAmount.HasValue)
                            .GroupBy(o => new { o.OrderDate.Year, o.OrderDate.Month })
                            .Select(g => new MonthlyRevenue
                            {
                                Month = $"{g.Key.Month:00}/{g.Key.Year}",
                                Revenue = g.Sum(o => o.TotalAmount ?? 0)
                            })
                            .OrderBy(x => x.Month)
                            .ToList();

                        totalRevenue = orders
                            .Where(o => o.Status?.ToLower() == "paid" && o.TotalAmount.HasValue)
                            .Sum(o => o.TotalAmount ?? 0);

                        var defaultPaidOrders = orders.Where(o => o.Status?.ToLower() == "paid" && o.TotalAmount.HasValue).ToList();
                        averageOrderValue = defaultPaidOrders.Any() ? defaultPaidOrders.Average(o => o.TotalAmount ?? 0) : 0;
                        break;
                }

                // Order status distribution - Luôn hiển thị
                orderStatusDistribution = orders
                    .GroupBy(o => o.Status?.ToLower() ?? "unknown")
                    .Select(g => new OrderStatusCount
                    {
                        Status = g.Key,
                        Count = g.Count()
                    })
                    .ToList();

                // Load top products - Chỉ load nếu không phải báo cáo customers
                if (reportType?.ToLower() != "customers")
                {
                    await LoadTopProducts(orders);
                }
                else
                {
                    topProducts.Clear();
                    totalProductsSold = 0;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading statistics: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await RenderCharts();
        }
    }

    private async Task LoadTopProducts(List<OrderDto> orders)
    {
        try
        {
            var orderIds = orders.Select(o => o.Id).ToList();
            var allOrderItems = new List<OrderItemDto>();

            // Load order items for all orders
            foreach (var orderId in orderIds)
            {
                if (Guid.TryParse(orderId, out var orderGuid))
                {
                    var orderItemsResponse = await OrderItemService.GetOrderItemsByOrderIdAsync(orderGuid, page: 1, pageSize: 10000);
                    if (orderItemsResponse?.StatusCode == 200 && orderItemsResponse.Data?.orderItems != null)
                    {
                        allOrderItems.AddRange(orderItemsResponse.Data.orderItems);
                    }
                }
            }

            // Group by product and calculate totals
            var productStats = allOrderItems
                .GroupBy(oi => oi.ProductId)
                .Select(g => new
                {
                    ProductId = g.Key,
                    QuantitySold = g.Sum(oi => oi.Quantity),
                    TotalRevenue = g.Sum(oi => oi.Price * oi.Quantity)
                })
                .OrderByDescending(x => x.TotalRevenue) // Sắp xếp theo doanh thu để lấy top sản phẩm bán chạy nhất
                .Take(10)
                .ToList();

            topProducts.Clear();
            totalProductsSold = allOrderItems.Sum(oi => oi.Quantity);

            // Load product names
            foreach (var stat in productStats)
            {
                if (!string.IsNullOrEmpty(stat.ProductId))
                {
                    var productResponse = await ProductService.GetProductByIdAsync(stat.ProductId);
                    var productName = productResponse?.StatusCode == 200 && productResponse.Data?.Product != null
                        ? productResponse.Data.Product.ProductName
                        : "Sản phẩm không xác định";

                    topProducts.Add(new TopProduct
                    {
                        ProductId = stat.ProductId,
                        ProductName = productName,
                        QuantitySold = stat.QuantitySold,
                        TotalRevenue = stat.TotalRevenue
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading top products: {ex.Message}");
        }
    }

    private async Task RenderCharts()
    {
        if (isLoading) return;

        try
        {
            // Revenue Chart - Hiển thị theo loại báo cáo
            if (monthlyRevenue.Any())
            {
                var labels = monthlyRevenue.Select(m => m.Month).ToArray();
                var data = monthlyRevenue.Select(m => (double)m.Revenue).ToArray();
                
                var (chartLabel, chartType) = GetChartConfig();
                var isCurrency = reportType?.ToLower() == "revenue";
                
                if (reportType?.ToLower() == "revenue" && !useBarChart)
                {
                    await JSRuntime.InvokeVoidAsync("chartHelper.createLineChart",
                        "revenueChart", labels, data, chartLabel,
                        "rgba(52, 152, 219, 0.1)", "rgba(52, 152, 219, 1)", isCurrency);
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("chartHelper.createBarChart",
                        "revenueChart", labels, data, chartLabel,
                        "rgba(52, 152, 219, 0.6)", "rgba(52, 152, 219, 1)", isCurrency);
                }
            }

            // Top Products Chart - Hiển thị 5 sản phẩm bán chạy nhất
            if (topProducts.Any())
            {
                // Lấy tối đa 5 sản phẩm (đã được sắp xếp và lấy 5 ở trên)
                var productsToShow = topProducts.Take(10).ToList();
                
                var productLabels = productsToShow.Select(p => p.ProductName.Length > 15 
                    ? p.ProductName.Substring(0, 15) + "..." 
                    : p.ProductName).ToArray();
                
                // Hiển thị theo doanh thu (TotalRevenue) thay vì số lượng để phản ánh đúng "bán chạy"
                var productData = productsToShow.Select(p => (double)p.TotalRevenue).ToArray();
                
                await JSRuntime.InvokeVoidAsync("chartHelper.createBarChart",
                    "topProductsChart", productLabels, productData, "Doanh thu (VNĐ)",
                    "rgba(52, 152, 219, 0.6)", "rgba(52, 152, 219, 1)");
            }

            // Status Distribution Chart
            if (orderStatusDistribution.Any())
            {
                var statusLabels = orderStatusDistribution.Select(s => GetStatusDisplayName(s.Status)).ToArray();
                var statusData = orderStatusDistribution.Select(s => (double)s.Count).ToArray();
                var statusColors = orderStatusDistribution.Select(s => 
                    s.Status == "paid" ? "rgba(75, 192, 192, 0.8)" :
                    s.Status == "pending" ? "rgba(255, 206, 86, 0.8)" :
                    s.Status == "canceled" ? "rgba(255, 99, 132, 0.8)" :
                    "rgba(153, 102, 255, 0.8)").ToArray();
                
                await JSRuntime.InvokeVoidAsync("chartHelper.createDoughnutChart",
                    "statusChart", statusLabels, statusData, statusColors);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering charts: {ex.Message}");
        }
    }

    private async Task OnReportTypeChanged(ChangeEventArgs e)
    {
        reportType = e.Value?.ToString() ?? "revenue";
        await LoadStatistics();
    }

    private async Task ToggleChartType()
    {
        useBarChart = !useBarChart;
        await RenderCharts();
    }

    private async Task ExportToPDF()
    {
        try
        {
            if (!monthlyRevenue.Any())
            {
                await JSRuntime.InvokeVoidAsync("alert", "Không có dữ liệu để xuất báo cáo!");
                return;
            }

            var title = $"Báo cáo thống kê - {DateTime.Now:dd/MM/yyyy}";
            var headers = new[] { "Tháng", "Doanh thu (VNĐ)" };
            var rows = monthlyRevenue.Select(m => new object[] { m.Month, FormatPrice(m.Revenue) }).ToList();
            
            var exportData = new
            {
                headers = headers,
                rows = rows
            };

            var result = await JSRuntime.InvokeAsync<bool>("exportHelper.exportToPDF", title, exportData);
            if (!result)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Có lỗi xảy ra khi xuất PDF. Vui lòng kiểm tra console để biết thêm chi tiết.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting to PDF: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Lỗi khi xuất PDF: {ex.Message}");
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            if (!monthlyRevenue.Any() && !topProducts.Any() && !orderStatusDistribution.Any())
            {
                await JSRuntime.InvokeVoidAsync("alert", "Không có dữ liệu để xuất báo cáo!");
                return;
            }

            var title = $"Bao_cao_thong_ke_{DateTime.Now:yyyyMMdd}";
            
            var sheets = new List<object>();
            
            if (monthlyRevenue.Any())
            {
                sheets.Add(new
                {
                    name = "Doanh thu theo tháng",
                    headers = new[] { "Tháng", "Doanh thu (VNĐ)" },
                    rows = monthlyRevenue.Select(m => new object[] { m.Month, m.Revenue }).ToList()
                });
            }
            
            if (topProducts.Any())
            {
                sheets.Add(new
                {
                    name = "Top sản phẩm",
                    headers = new[] { "Tên sản phẩm", "Số lượng bán", "Doanh thu (VNĐ)" },
                    rows = topProducts.Select(p => new object[] { p.ProductName, p.QuantitySold, p.TotalRevenue }).ToList()
                });
            }
            
            if (orderStatusDistribution.Any())
            {
                sheets.Add(new
                {
                    name = "Phân bố trạng thái",
                    headers = new[] { "Trạng thái", "Số lượng" },
                    rows = orderStatusDistribution.Select(s => new object[] { GetStatusDisplayName(s.Status), s.Count }).ToList()
                });
            }

            var exportData = new { sheets = sheets.ToArray() };
            var result = await JSRuntime.InvokeAsync<bool>("exportHelper.exportToExcel", title, exportData);
            if (!result)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Có lỗi xảy ra khi xuất Excel. Vui lòng kiểm tra console để biết thêm chi tiết.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting to Excel: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Lỗi khi xuất Excel: {ex.Message}");
        }
    }

    private string GetChartTitle()
    {
        return reportType?.ToLower() switch
        {
            "revenue" => "Biểu đồ doanh thu theo tháng",
            "orders" => "Biểu đồ số lượng đơn hàng theo tháng",
            "products" => "Thống kê sản phẩm",
            "customers" => "Biểu đồ số lượng khách hàng theo tháng",
            _ => "Biểu đồ doanh thu theo tháng"
        };
    }

    private (string Label, string Type) GetChartConfig()
    {
        return reportType?.ToLower() switch
        {
            "revenue" => ("Doanh thu (VNĐ)", "bar"),
            "orders" => ("Số lượng đơn hàng", "bar"),
            "customers" => ("Số lượng khách hàng", "bar"),
            _ => ("Doanh thu (VNĐ)", "bar")
        };
    }

    private string GetSummaryLabel(string field)
    {
        return reportType?.ToLower() switch
        {
            "revenue" => field switch
            {
                "total" => "Tổng doanh thu",
                "average" => "Đơn hàng trung bình",
                _ => field
            },
            "orders" => field switch
            {
                "total" => "Tổng đơn hàng",
                "average" => "Đơn hàng trung bình/tháng",
                _ => field
            },
            "customers" => field switch
            {
                "total" => "Tổng khách hàng",
                "average" => "Đơn hàng trung bình/khách hàng",
                _ => field
            },
            _ => field switch
            {
                "total" => "Tổng doanh thu",
                "average" => "Đơn hàng trung bình",
                _ => field
            }
        };
    }

    private string FormatPrice(decimal amount)
    {
        // Nếu là báo cáo orders hoặc customers, format như số nguyên
        if (reportType?.ToLower() == "orders" || reportType?.ToLower() == "customers")
        {
            return amount.ToString("N0");
        }
        return $"{amount:N0} VNĐ";
    }

    private string GetStatusDisplayName(string? status)
    {
        return status?.ToLower() switch
        {
            "paid" => "Đã thanh toán",
            "pending" => "Chờ xử lý",
            "canceled" => "Đã hủy",
            _ => "Không xác định"
        };
    }

    private string GetStatusColor(string? status)
    {
        return status?.ToLower() switch
        {
            "paid" => "bg-success",
            "pending" => "bg-warning",
            "canceled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private class MonthlyRevenue
    {
        public string Month { get; set; } = "";
        public decimal Revenue { get; set; }
    }

    private class TopProduct
    {
        public string ProductId { get; set; } = "";
        public string ProductName { get; set; } = "";
        public int QuantitySold { get; set; }
        public decimal TotalRevenue { get; set; }
    }

    private class OrderStatusCount
    {
        public string Status { get; set; } = "";
        public int Count { get; set; }
    }
}
