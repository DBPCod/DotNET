    private void ShowCreateModal()
    {
        isEdit = false;
        editingDiscount = null;
        currentDiscount = new CreatePromotionRequest
        {
            StartDate = DateTime.Today,
            EndDate = DateTime.Today.AddDays(30),
            Status = PromotionStatus.Active,
            DiscountType = DiscountType.Percent,
            PromotionType = PromotionType.DiscountCode
        };
        showModal = true;
    }

    private void ShowEditModal(PromotionDto discount)
    {
        isEdit = true;
        editingDiscount = discount;
        currentDiscount = new CreatePromotionRequest
        {
            PromoCode = discount.PromoCode,
            Description = discount.Description,
            DiscountType = discount.DiscountType,
            DiscountValue = discount.DiscountValue,
            PromotionType = PromotionType.DiscountCode,
            StartDate = discount.StartDate,
            EndDate = discount.EndDate,
            MinOrderAmount = discount.MinOrderAmount,
            UsageLimit = discount.UsageLimit,
            Status = discount.Status
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        isEdit = false;
        editingDiscount = null;
        currentDiscount = new CreatePromotionRequest();
    }

    private void HandleDiscountTypeChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "percent";
        currentDiscount.DiscountType = val switch
        {
            "percent" => DiscountType.Percent,
            "fixed" => DiscountType.Fixed,
            "free_shipping" => DiscountType.FreeShipping,
            _ => DiscountType.Percent
        };
        if (currentDiscount.DiscountType == DiscountType.FreeShipping)
        {
            currentDiscount.DiscountValue = 0;
        }
        StateHasChanged();
    }

    private async Task SaveDiscount()
    {
        try
        {
            // Đảm bảo PromotionType luôn là discount_code
            currentDiscount.PromotionType = PromotionType.DiscountCode;

            // Validate client-side
            var (isValid, validationMessage) = ValidateDiscountForm(currentDiscount, isEdit);
            if (!isValid)
            {
                Toast.ShowError(validationMessage);
                return;
            }

            bool success;
            
            if (isEdit && editingDiscount != null)
            {
                var updateRequest = new UpdatePromotionRequest
                {
                    Description = currentDiscount.Description,
                    DiscountType = currentDiscount.DiscountType,
                    DiscountValue = currentDiscount.DiscountValue,
                    PromotionType = PromotionType.DiscountCode,
                    StartDate = currentDiscount.StartDate,
                    EndDate = currentDiscount.EndDate,
                    MinOrderAmount = currentDiscount.MinOrderAmount,
                    UsageLimit = currentDiscount.UsageLimit,
                    Status = currentDiscount.Status
                };
                
                success = await PromotionService.UpdatePromotionAsync(editingDiscount.Id, updateRequest);
            }
            else
            {
                success = await PromotionService.CreatePromotionAsync(currentDiscount);
            }

            if (success)
            {
                var wasEdit = isEdit;
                CloseModal();
                await LoadDiscountCodes(pagination?.CurrentPage ?? 1);
                Toast.ShowSuccess(wasEdit ? "Cập nhật thành công!" : "Tạo mã giảm giá thành công!");
            }
            else
            {
                Toast.ShowError("Có lỗi xảy ra!");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi: {ex.Message}");
        }
    }

