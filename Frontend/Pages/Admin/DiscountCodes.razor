        };
    }

    private string GetDiscountTypeIconClass(DiscountType discountType)
    {
        return discountType switch
        {
            DiscountType.Percent => "bi bi-percent",
            DiscountType.Fixed => "bi bi-currency-dollar",
            DiscountType.FreeShipping => "bi bi-truck",
            _ => "bi bi-tag"
        };
    }

    private string GetStatusDisplay(PromotionDto discount)
    {
        var today = DateTime.Today;
        if (discount.Status == PromotionStatus.Active)
        {
            if (today < discount.StartDate)
                return "Chưa kích hoạt";
            if (today > discount.EndDate)
                return "Hết hạn";
            return "Hoạt động";
        }
        return "Tạm dừng";
    }

    private string GetStatusBadgeClass(PromotionDto discount)
    {
        var today = DateTime.Today;
        if (discount.Status == PromotionStatus.Active)
        {
            if (today < discount.StartDate)
                return "bg-info";
            if (today > discount.EndDate)
                return "bg-warning";
            return "bg-success";
        }
        return "bg-secondary";
    }

    private void HandleStatusEnumChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "Active";
        currentDiscount.Status = val == "Inactive" ? PromotionStatus.Inactive : PromotionStatus.Active;
    }

    private string FormatCurrency(decimal amount)
    {
        return $"{amount:N0} VNĐ";
    }

    private (bool ok, string message) ValidateDiscountForm(CreatePromotionRequest request, bool isEditMode)
    {
        if (!isEditMode && string.IsNullOrWhiteSpace(request.PromoCode))
            return (false, "Mã giảm giá là bắt buộc");

        if (request.EndDate < request.StartDate)
            return (false, "Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu");

        if (request.DiscountType == DiscountType.Percent)
        {
            if (request.DiscountValue <= 0 || request.DiscountValue > 100)
                return (false, "% giảm phải trong khoảng 1-100");
        }
        else if (request.DiscountType == DiscountType.Fixed)
        {
            if (request.DiscountValue < 0)
                return (false, "Giá trị giảm cố định phải ≥ 0");
        }
        else if (request.DiscountType == DiscountType.FreeShipping)
        {
            if (request.DiscountValue != 0)
                return (false, "Miễn phí vận chuyển không cần giá trị giảm");
        }

        if (request.MinOrderAmount < 0)
            return (false, "Giá trị đơn hàng tối thiểu phải ≥ 0");

        if (request.UsageLimit < 0)
            return (false, "Giới hạn sử dụng phải ≥ 0");

        return (true, "");
    }
