    private void AddToCart(ProductDto product)
    {
        var existingItem = cartItems.FirstOrDefault(x => x.ProductId == Guid.Parse(product.Id));
        if (existingItem != null)
        {
            existingItem.Quantity += 1;
        }
        else
        {
            cartItems.Add(new CartItem
            {
                ProductId = Guid.Parse(product.Id),
                ProductName = product.ProductName,
                Price = product.Price,
                Quantity = 1
            });
        }
        UpdateTotals();
    }

    private void UpdateQuantity(CartItem item, int delta)
    {
        var newQuantity = item.Quantity + delta;
        if (newQuantity >= 1)  // Strict >=1, không cho phép =0
        {
            item.Quantity = newQuantity;
            UpdateTotals();
        }
        // Thêm: Disable +/- nếu cần, nhưng UI sẽ handle qua min=1 trên input
        StateHasChanged();
    }

    private void RemoveFromCart(CartItem item)
    {
        cartItems.Remove(item);
        UpdateTotals();
        StateHasChanged();
    }

    private void UpdateTotals()
    {
        subTotal = cartItems.Sum(x => x.Price * x.Quantity);
        var discount = createOrderForm.DiscountAmount ?? 0;
        totalAmount = subTotal - discount;
        createOrderForm.TotalAmount = totalAmount;
        Console.WriteLine($"Totals updated: Sub={subTotal}, Discount={discount}, Total={totalAmount}");  // Log để debug
        StateHasChanged();
    }

    private async Task HandleCreateOrderSubmit()
    {
        if (selectedCustomerForCreate == null || !cartItems.Any())
        {
            createErrorMessage = "Vui lòng chọn khách hàng và thêm ít nhất một sản phẩm.";
            StateHasChanged();
            return;
        }

        // THÊM MỚI: Validation quantity cho tất cả items
        var invalidItems = cartItems.Where(i => i.Quantity <= 0).ToList();
        if (invalidItems.Any())
        {
            createErrorMessage = $"Các sản phẩm sau có số lượng không hợp lệ (phải >=1): {string.Join(", ", invalidItems.Select(i => i.ProductName))}";
            Toast.ShowWarning(createErrorMessage);
            StateHasChanged();
            return;
        }

        isCreatingOrder = true;
        createErrorMessage = string.Empty;
        StateHasChanged();

        try
        {
            // Bước 1: Tạo Order
            var orderRequest = new CreateOrderRequest
            {
                CustomerId = createOrderForm.CustomerId,
                UserId = createOrderForm.UserId,
                PromoId = string.IsNullOrEmpty(SelectedPromotionId) ? null : Guid.Parse(SelectedPromotionId),
                TotalAmount = totalAmount,
                DiscountAmount = createOrderForm.DiscountAmount ?? 0
            };

            var orderResponse = await OrderService.CreateOrderAsync(orderRequest);

            if ((orderResponse?.StatusCode != 200 && orderResponse.StatusCode != 201) || orderResponse.Data == null)
            {
                createErrorMessage = $"Lỗi tạo đơn hàng: {orderResponse?.Message ?? "Unknown error"}";
                Toast.ShowError(createErrorMessage);
                return;
            }

            var newOrderIdStr = orderResponse.Data.order.Id; // Giả sử OrderDetailResponse có property Id là string
            if (!Guid.TryParse(newOrderIdStr, out var newOrderId))
            {
                createErrorMessage = "Lỗi: Mã đơn hàng mới không hợp lệ.";
                Toast.ShowError(createErrorMessage);
                return;
            }

            // Bước 2: Tạo Order Items
            var items = cartItems.Select(item => new OrderItemInput
            {
                ProductId = item.ProductId,
                Quantity = item.Quantity  // Đảm bảo >0 từ validation
            }).ToList();
        
            var itemsRequest = new CreateOrderItemsRequest
            {
                OrderId = newOrderId,
                Items = items
            };

            var itemsResponse = await OrderItemService.CreateOrderItemsAsync(itemsRequest);

            // THÊM MỚI: Hiển thị toast thành công giống như bên user management (sử dụng Toast.ShowSuccess với message đơn giản và chi tiết)
            var successMessage = $"Tạo đơn hàng mới thành công! Mã đơn: #{GetOrderIdDisplay(newOrderId)}";
            Toast.ShowSuccess(successMessage);
            CloseCreateOrderModal();
            await LoadOrders();  // Reload list
        }
        catch (Exception ex)
        {
            createErrorMessage = $"Lỗi: {ex.Message}";
            Toast.ShowError(createErrorMessage);
            Console.WriteLine($"Full exception: {ex}");  // Log stack trace
        }
        finally
        {
            isCreatingOrder = false;
            StateHasChanged();
        }
    }

