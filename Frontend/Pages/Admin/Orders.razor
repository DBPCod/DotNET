                Console.WriteLine($"API returned non-200 status: {response?.StatusCode}. Message: {response?.Message}");
                Toast.ShowWarning("Không thể tải chi tiết đơn hàng.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching order items for {selectedOrderId}: {ex.Message}");
            orderItems = new();
            orderPagination = null;
            Toast.ShowError($"Lỗi khi tải chi tiết đơn hàng: {ex.Message}");
