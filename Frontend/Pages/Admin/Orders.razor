    protected override async Task OnInitializedAsync()
    {
        cts = new CancellationTokenSource();
        _toDate = DateTime.Today;
        // Thêm mới: Lấy dữ liệu từ localStorage
        var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "auth_user");
        if (!string.IsNullOrEmpty(json))
        {
            var user = JsonSerializer.Deserialize<Dictionary<string, object>>(json);
            var userIdStr = user["Id"].ToString() ?? "00000000-0000-0000-0000-000000000000";
            currentUserId = Guid.Parse(userIdStr);
            userName = user["Username"].ToString() ?? "Administrator";
        }
        createOrderForm.UserId = currentUserId;
        StateHasChanged();
        await LoadOrders();
    }

    // Existing methods: LoadOrders, etc. (giữ nguyên từ code trước)
    private async Task LoadOrders()
    {
        isLoading = true;
        customerMap.Clear();
        StateHasChanged();

        try
        {
            var apiResponse = await OrderService.GetOrdersAsync(
                page: currentPage,
                pageSize: 10,
                q: searchTerm,
                status: StatusFilter,
                fromDate: FromDate,
                toDate: ToDate
            );

            Console.WriteLine($"API Response: {System.Text.Json.JsonSerializer.Serialize(apiResponse)}");

            if (apiResponse?.StatusCode == 200 && apiResponse.Data != null)
            {
                orders = apiResponse.Data.Orders ?? new();
                pagination = apiResponse.Data.Pagination;
                currentPage = pagination.CurrentPage;

                foreach (var order in orders)
                {
                    Console.WriteLine($"OrderId: {order.Id}, Status: {order.Status}, Total: {order.TotalAmount}");
                }

                // Fetch customer details for unique customer IDs in parallel
                var uniqueCustomerIds = orders.Select(o => o.CustomerId).Distinct().ToList();
                if (uniqueCustomerIds.Any())
                {
                    var customerTasks = uniqueCustomerIds.Select(id => FetchCustomerAsync(id)).ToArray();
                    var customerResults = await Task.WhenAll(customerTasks);
                    for (int i = 0; i < uniqueCustomerIds.Count; i++)
                    {
                        var customer = customerResults[i];
                        if (customer != null)
                        {
                            customerMap[uniqueCustomerIds[i]] = customer;
                        }
                    }
                }
            }
            else
            {
                orders = new();
                pagination = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading orders: {ex.Message}");
            orders = new();
            pagination = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

