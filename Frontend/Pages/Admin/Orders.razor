    private async Task ViewOrder(string idStr)
    {
        if (string.IsNullOrEmpty(idStr) || !Guid.TryParse(idStr, out selectedOrderId))
        {
            Console.WriteLine($"Invalid order ID: {idStr}");
            Toast.ShowWarning("Mã đơn hàng không hợp lệ.");
            return;
        }

        orderItemCurrentPage = 1;
        showModal = true;
        isLoadingOrderItems = true;
        StateHasChanged();

        try
        {
            Console.WriteLine($"Calling API to fetch order items for OrderId: {selectedOrderId}");

            var response = await OrderItemService.GetOrderItemsByOrderIdAsync(selectedOrderId, page: 1, pageSize: 10);

            if (response?.StatusCode == 200 && response.Data != null)
            {
                orderItems = response.Data.orderItems ?? new();
                orderPagination = response.Data.Pagination;
                Console.WriteLine($"Success! Fetched {orderItems.Count} order items for {selectedOrderId}.");
