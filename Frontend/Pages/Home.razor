@page "/"
@using Frontend.Services
@using Frontend.Models.Product
@using Frontend.Models.Product.Responses
@inject ProductService ProductService
@inject CartService CartService
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject InventoryService InventoryService
@inject Blazored.Toast.Services.IToastService ToastService

<PageTitle>Spot247 - Cửa hàng bán lẻ</PageTitle>

<section class="home-hero">
    <div id="homeCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active home-hero-slide home-hero-slide-1">
                <div class="container h-100 d-flex flex-column justify-content-center">
                    <div class="home-hero-content">
                        <h1 class="home-hero-title">Spot247 - Cửa hàng tiện lợi mỗi ngày</h1>
                        <p class="home-hero-text">
                            Đặt mua nhanh đồ uống, bánh kẹo, gia vị, gia dụng... giao hàng tận nơi chỉ trong vài bước.
                        </p>
                        <button class="btn btn-light btn-lg" @onclick="ScrollToProducts">
                            <i class="bi bi-bag-check"></i> Bắt đầu mua sắm
                        </button>
                    </div>
                </div>
            </div>
            <div class="carousel-item home-hero-slide home-hero-slide-2">
                <div class="container h-100 d-flex flex-column justify-content-center">
                    <div class="home-hero-content">
                        <h2 class="home-hero-title">Ưu đãi mỗi ngày</h2>
                        <p class="home-hero-text">
                            Hàng chục sản phẩm khuyến mãi, hỗ trợ khách quen, phù hợp cho cửa hàng nhỏ và hộ gia đình.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>

<div class="products-section" id="products">
    <div class="container">
        <div class="section-header d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="section-title">Sản phẩm nổi bật</h2>
                <p class="section-subtitle mb-0">
                    Chọn sản phẩm và thêm vào giỏ hàng để đặt mua.
                </p>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Đang tải sản phẩm...</span>
                </div>
            </div>
        }
        else if (loadError is not null)
        {
            <div class="alert alert-danger">
                @loadError
            </div>
        }
        else if (products is null || !products.Any())
        {
            <div class="alert alert-info">
                Hiện chưa có sản phẩm nào.
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var product in products)
                {
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="product-card h-100 d-flex flex-column" id="@($"product-{product.Id}")">
                            <div class="product-image-wrapper">
                                @if (!string.IsNullOrEmpty(product.ImagePath))
                                {
                                    <img class="product-image" src="@GetImageUrl(product.ImagePath)" alt="@product.ProductName" />
                                }
                                else
                                {
                                    <div class="product-image product-image-placeholder">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                            </div>
                            <div class="product-body flex-grow-1 d-flex flex-column">
                                <h5 class="product-name">@product.ProductName</h5>
                                <div class="product-price-row d-flex justify-content-between align-items-center mb-2">
                                    <p class="product-price mb-0">@ProductService.FormatPrice(product.Price)</p>
                                    <p class="product-unit text-muted mb-0">@product.Unit</p>
                                </div>
                                @if (!string.IsNullOrEmpty(product.CategoryName))
                                {
                                    <p class="product-category text-muted mb-2">
                                        <i class="bi bi-tag"></i> @product.CategoryName
                                    </p>
                                }
                                @{
                                    var stockQuantity = GetInventoryQuantity(product.Id);
                                }
                                @if (stockQuantity > 0)
                                {
                                    <p class="product-stock text-success mb-2">
                                        <i class="bi bi-check-circle"></i> Còn @stockQuantity sản phẩm
                                    </p>
                                    <button class="btn btn-sm btn-primary mt-auto" @onclick="() => AddToCart(product, product.Id)">
                                        <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                    </button>
                                }
                                else
                                {
                                    <p class="product-stock text-danger mb-2">
                                        <i class="bi bi-x-circle"></i> Hết hàng
                                    </p>
                                    <button class="btn btn-sm btn-secondary mt-auto" disabled>
                                        <i class="bi bi-cart-x"></i> Hết hàng
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="stats-section">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-3">
                <div class="stat-item">
                    <h3>50+</h3>
                    <p>Sản phẩm đa dạng</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-item">
                    <h3>5</h3>
                    <p>Danh mục chính</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-item">
                    <h3>20+</h3>
                    <p>Khách hàng</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-item">
                    <h3>30+</h3>
                    <p>Đơn hàng</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ProductDto>? products;
    private Dictionary<string, int> productInventories = new(); // Lưu số lượng tồn kho theo ProductId
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            isLoading = true;
            loadError = null;

            // Lấy tất cả sản phẩm đang hoạt động, bỏ giới hạn 20
            var response = await ProductService.GetProductsAsync(page: 1, pageSize: 1000, status: true);
            if (response?.StatusCode == 200 && response.Data is not null)
            {
                products = response.Data.Products;
                
                // Load số lượng tồn kho cho từng sản phẩm
                await LoadInventories();
            }
            else
            {
                loadError = response?.Message ?? "Không thể tải danh sách sản phẩm.";
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadInventories()
    {
        if (products == null || !products.Any()) return;

        foreach (var product in products)
        {
            try
            {
                var inventoryResponse = await InventoryService.GetInventoryByProductIdAsync(product.Id);
                if (inventoryResponse?.StatusCode == 200 && inventoryResponse.Data?.Inventory != null)
                {
                    productInventories[product.Id] = inventoryResponse.Data.Inventory.Quantity;
                }
                else
                {
                    productInventories[product.Id] = 0;
                }
            }
            catch
            {
                productInventories[product.Id] = 0;
            }
        }
    }

    private int GetInventoryQuantity(string productId)
    {
        return productInventories.TryGetValue(productId, out var quantity) ? quantity : 0;
    }

    private async Task AddToCart(ProductDto product, string productId)
    {
        try
        {
            // Kiểm tra số lượng tồn kho
            var inventoryResponse = await InventoryService.GetInventoryByProductIdAsync(productId);
            
            if (inventoryResponse == null || inventoryResponse.StatusCode != 200 || inventoryResponse.Data?.Inventory == null)
            {
                ToastService.ShowWarning("Không thể kiểm tra tồn kho của sản phẩm này");
                return;
            }
            
            var inventory = inventoryResponse.Data.Inventory;
            
            // Kiểm tra hết hàng
            if (inventory.Quantity <= 0)
            {
                ToastService.ShowError($"Sản phẩm '{product.ProductName}' đã hết hàng!");
                return;
            }
            
            // Thêm vào giỏ hàng với kiểm tra số lượng tồn
            bool added = CartService.AddToCart(product, 1, inventory.Quantity);
            
            if (added)
            {
                ToastService.ShowSuccess($"Đã thêm '{product.ProductName}' vào giỏ hàng");
                
                // Tạo hiệu ứng bay vào giỏ hàng
                var elementId = $"product-{productId}";
                await AnimateToCart(elementId);
                
                // Cập nhật UI
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError($"Không thể thêm sản phẩm. Chỉ còn {inventory.Quantity} sản phẩm trong kho!");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding to cart: {ex.Message}");
            ToastService.ShowError("Có lỗi xảy ra khi thêm sản phẩm vào giỏ hàng");
        }
    }

    private async Task AnimateToCart(string elementId)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("animateProductToCart", elementId);
        }
        catch
        {
            // Ignore JS errors
        }
    }

    private string GetImageUrl(string imagePath)
        => $"http://localhost:4040/{imagePath.TrimStart('/')}";

    private void ScrollToProducts()
    {
        NavigationManager.NavigateTo("#products");
    }
}

