@page "/auth/reset-password"
@layout AuthLayout
@using Frontend.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject Blazored.Toast.Services.IToastService ToastService
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<div class="auth-header">
    <h1 class="auth-title">Đặt lại mật khẩu</h1>
    <p class="auth-subtitle">Nhập mật khẩu mới cho tài khoản @email</p>
</div>

<form class="auth-form" @onsubmit="HandleSubmit">
    <div class="form-group">
        <label class="form-label" for="newPassword">Mật khẩu mới</label>
        <input class="form-input" id="newPassword" type="password" placeholder="Nhập mật khẩu mới"
               @bind="formData.NewPassword" @oninput="() => ClearError(nameof(formData.NewPassword))" />
        @if (errors.ContainsKey(nameof(formData.NewPassword)))
        {
            <div class="form-error">@errors[nameof(formData.NewPassword)]</div>
        }
    </div>

    <div class="form-group">
        <label class="form-label" for="rePassword">Xác nhận mật khẩu</label>
        <input class="form-input" id="rePassword" type="password" placeholder="Nhập lại mật khẩu"
               @bind="formData.RePassword" @oninput="() => ClearError(nameof(formData.RePassword))" />
        @if (errors.ContainsKey(nameof(formData.RePassword)))
        {
            <div class="form-error">@errors[nameof(formData.RePassword)]</div>
        }
    </div>

    <button type="submit" class="btn btn-primary" disabled="@AuthService.IsLoading">
        @if (AuthService.IsLoading)
        {
            <svg class="btn-icon spinner" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
            </svg>
            <span>Đang cập nhật...</span>
        }
        else
        {
            <span>Đổi mật khẩu</span>
        }
    </button>
</form>

<div class="auth-link">
    <a href="/auth/login">Quay lại đăng nhập</a>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? email { get; set; }

    private class FormData
    {
        public string NewPassword { get; set; } = "";
        public string RePassword { get; set; } = "";
    }

    private FormData formData = new();
    private Dictionary<string, string> errors = new();

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        if (string.IsNullOrWhiteSpace(email))
        {
            ToastService.ShowError("Thiếu email, vui lòng nhập lại OTP.");
            Navigation.NavigateTo("/auth/forgot-password");
        }
    }

    private void ClearError(string field)
    {
        if (errors.ContainsKey(field))
        {
            errors.Remove(field);
        }
    }

    private bool Validate()
    {
        errors.Clear();

        if (string.IsNullOrWhiteSpace(formData.NewPassword))
        {
            errors[nameof(formData.NewPassword)] = "Mật khẩu là bắt buộc";
        }
        else if (formData.NewPassword.Length < 8)
        {
            errors[nameof(formData.NewPassword)] = "Mật khẩu phải có ít nhất 8 ký tự";
        }

        if (string.IsNullOrWhiteSpace(formData.RePassword))
        {
            errors[nameof(formData.RePassword)] = "Vui lòng xác nhận mật khẩu";
        }
        else if (formData.NewPassword != formData.RePassword)
        {
            errors[nameof(formData.RePassword)] = "Mật khẩu không trùng khớp";
        }

        return errors.Count == 0;
    }

    private async Task HandleSubmit()
    {
        if (!Validate())
        {
            return;
        }

        var response = await AuthService.ForgotPasswordAsync(
            email ?? "",
            formData.NewPassword,
            formData.RePassword
        );

        if (response == null)
        {
            ToastService.ShowError(AuthService.ErrorMessage);
            return;
        }

        if (response.StatusCode == 200)
        {
            ToastService.ShowSuccess("Đổi mật khẩu thành công");
            Navigation.NavigateTo("/auth/login");
            return;
        }

        ToastService.ShowError(response.Message);
    }
}