@page "/auth/reset-password"
@layout AuthLayout
@using Frontend.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject Blazored.Toast.Services.IToastService ToastService

<div class="auth-header">
    <div class="icon-badge">
        <svg class="icon-badge-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="m4.93 4.93 4.24 4.24"></path>
            <path d="m14.83 9.17 4.24-4.24"></path>
            <path d="m14.83 14.83 4.24 4.24"></path>
            <path d="m9.17 14.83-4.24 4.24"></path>
            <circle cx="12" cy="12" r="4"></circle>
        </svg>
    </div>
    <h1 class="auth-title">Đặt lại mật khẩu</h1>
    <p class="auth-subtitle">Tạo mật khẩu mới cho tài khoản <strong>@email</strong></p>
</div>

<form class="auth-form" @onsubmit="HandleSubmit">
    <div class="form-group">
        <label class="form-label" for="newPassword">Mật khẩu mới</label>
        <div class="form-input-wrapper">
            <svg class="form-input-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <input class="form-input" id="newPassword" type="@(showPassword ? "text" : "password")"
                placeholder="Nhập mật khẩu mới" @bind="formData.NewPassword"
                @oninput="() => ClearError(nameof(formData.NewPassword))" />
            <svg class="form-input-icon-right" @onclick="TogglePassword" xmlns="http://www.w3.org/2000/svg" width="24"
                height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                @if (showPassword)
                {
                    <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                    <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                    <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                    <line x1="2" x2="22" y1="2" y2="22"></line>
                }
                else
                {
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                }
            </svg>
        </div>
        @if (errors.ContainsKey(nameof(formData.NewPassword)))
        {
            <div class="form-error">@errors[nameof(formData.NewPassword)]</div>
        }
        <p class="form-hint">Mật khẩu phải có ít nhất 8 ký tự</p>
    </div>

    <div class="form-group">
        <label class="form-label" for="confirmPassword">Xác nhận mật khẩu</label>
        <div class="form-input-wrapper">
            <svg class="form-input-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <input class="form-input" id="confirmPassword" type="@(showConfirmPassword ? "text" : "password")"
                placeholder="Nhập lại mật khẩu mới" @bind="formData.RePassword"
                @oninput="() => ClearError(nameof(formData.RePassword))" />
            <svg class="form-input-icon-right" @onclick="ToggleConfirmPassword" xmlns="http://www.w3.org/2000/svg"
                width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                @if (showConfirmPassword)
                {
                    <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                    <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                    <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                    <line x1="2" x2="22" y1="2" y2="22"></line>
                }
                else
                {
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                }
            </svg>
        </div>
        @if (errors.ContainsKey(nameof(formData.RePassword)))
        {
            <div class="form-error">@errors[nameof(formData.RePassword)]</div>
        }
    </div>

    <button type="submit" class="btn btn-primary" disabled="@AuthService.IsLoading">
        @if (AuthService.IsLoading)
        {
            <svg class="btn-icon spinner" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
            </svg>
            <span>Đang đặt lại...</span>
        }
        else
        {
            <span>Đặt lại mật khẩu</span>
        }
    </button>
</form>

<div style="text-align: center; margin-top: 1.5rem;">
    <a href="/auth/login" class="auth-back-link">
        <svg class="auth-back-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
        </svg>
        Quay lại trang đăng nhập
    </a>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? email { get; set; }

    private class FormData
    {
        public string NewPassword { get; set; } = "";
        public string RePassword { get; set; } = "";
    }

    private FormData formData = new();
    private Dictionary<string, string> errors = new();
    private bool showPassword = false;
    private bool showConfirmPassword = false;

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private void ToggleConfirmPassword()
    {
        showConfirmPassword = !showConfirmPassword;
    }

    private void ClearError(string field)
    {
        if (errors.ContainsKey(field))
        {
            errors.Remove(field);
        }
    }

    private bool Validate()
    {
        errors.Clear();

        if (string.IsNullOrWhiteSpace(formData.NewPassword))
        {
            errors[nameof(formData.NewPassword)] = "Vui lòng nhập mật khẩu mới";
        }
        else if (formData.NewPassword.Length < 8)
        {
            errors[nameof(formData.NewPassword)] = "Mật khẩu mới phải có ít nhất 8 ký tự";
        }

        if (string.IsNullOrWhiteSpace(formData.RePassword))
        {
            errors[nameof(formData.RePassword)] = "Vui lòng xác nhận lại mật khẩu";
        }
        else if (formData.NewPassword != formData.RePassword)
        {
            errors[nameof(formData.RePassword)] = "Mật khẩu không trùng khớp";
        }

        return errors.Count == 0;
    }

    private async Task HandleSubmit()
    {
        if (!Validate())
        {
            return;
        }

        var response = await AuthService.ForgotPasswordAsync(
        email ?? "",
        formData.NewPassword,
        formData.RePassword
        );

        if (response == null)
        {
            ToastService.ShowError(AuthService.ErrorMessage);
            return;
        }

        if (response.StatusCode == 200)
        {
            ToastService.ShowSuccess("Đổi mật khẩu thành công");
            Navigation.NavigateTo("/auth/login");
            return;
        }

        ToastService.ShowError(response.Message);
    }
}