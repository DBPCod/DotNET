@page "/auth/verification"
@layout AuthLayout
@using Frontend.Services
@using Microsoft.AspNetCore.Components
@using System.Timers
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject Blazored.Toast.Services.IToastService ToastService
@implements IDisposable

<div class="auth-header">
    <div class="icon-badge">
        <svg class="icon-badge-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path>
        </svg>
    </div>
    <h1 class="auth-title">Nhập mã xác thực</h1>
    <p class="auth-subtitle">
        Chúng tôi đã gửi mã OTP gồm 6 chữ số về email <strong>@email</strong>
    </p>
    <p class="auth-subtitle">
        Vui lòng nhập mã để @(isActivation ? "xác thực tài khoản" : "đặt lại mật khẩu")
    </p>
</div>

@if (!isExpired)
{
    <div class="info-box" style="margin-bottom: 1.5rem;">
        <svg class="info-box-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span class="info-box-text">Mã hết hạn trong: @FormatTime(timeLeft)</span>
    </div>
}

@if (isExpired)
{
    <div class="form-error" style="margin-bottom: 1.5rem;">
        Mã OTP đã hết hạn. Vui lòng yêu cầu gửi lại mã mới.
    </div>
}

<form class="auth-form" @onsubmit="HandleSubmit">
    <div class="otp-container">
        @for (int i = 0; i < 6; i++)
        {
            int index = i;
            <input @ref="otpInputs[index]" class="otp-input" type="text" maxlength="1" value="@otp[index]"
                @oninput="@(e => HandleOtpInput(index, e.Value?.ToString() ?? ""))"
                @onkeydown="@(e => HandleKeyDown(index, e))" @onpaste="@(e => HandlePaste(e))" disabled="@isExpired" />
        }
    </div>

    <button type="submit" class="btn btn-primary" disabled="@(AuthService.IsLoading || isExpired || !IsOtpComplete())">
        @if (AuthService.IsLoading)
        {
            <svg class="btn-icon spinner" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
            </svg>
            <span>Đang xác thực...</span>
        }
        else
        {
            <span>Xác thực</span>
        }
    </button>
</form>

<div style="text-align: center; margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
    <p class="auth-subtitle">
        Không nhận được mã?
        <button @onclick="HandleResend" disabled="@AuthService.IsLoading"
            style="background: none; border: none; color: #4f46e5; font-weight: 500; cursor: pointer; text-decoration: underline;">
            Gửi lại mã
        </button>
    </p>

    <a href="/auth/login" class="auth-back-link">
        <svg class="auth-back-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
        </svg>
        Quay lại trang đăng nhập
    </a>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? email { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public bool isActivation { get; set; }

    private string[] otp = new string[6];
    private ElementReference[] otpInputs = new ElementReference[6];
    private bool isExpired = false;
    private int timeLeft = 300; // 5 minutes in seconds
    private Timer? timer;

    protected override void OnInitialized()
    {
        // Start countdown timer
        timer = new Timer(1000); // 1 second interval
        timer.Elapsed += OnTimerElapsed;
        timer.Start();
    }

    private void OnTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        timeLeft--;

        if (timeLeft <= 0)
        {
            isExpired = true;
            timer?.Stop();
        }

        InvokeAsync(StateHasChanged);
    }

    private string FormatTime(int seconds)
    {
        int mins = seconds / 60;
        int secs = seconds % 60;
        return $"{mins}:{secs:D2}";
    }

    private void HandleOtpInput(int index, string value)
    {
        // Only allow digits
        if (!string.IsNullOrEmpty(value) && !char.IsDigit(value[0]))
            return;

        otp[index] = string.IsNullOrEmpty(value) ? "" : value.Substring(0, 1);

        // Auto-focus next input
        if (!string.IsNullOrEmpty(value) && index < 5)
        {
            otpInputs[index + 1].FocusAsync();
        }

        StateHasChanged();
    }

    private void HandleKeyDown(int index, KeyboardEventArgs e)
    {
        if (e.Key == "Backspace" && string.IsNullOrEmpty(otp[index]) && index > 0)
        {
            otpInputs[index - 1].FocusAsync();
        }
    }

    private async Task HandlePaste(ClipboardEventArgs e)
    {
        // Note: Blazor doesn't have direct clipboard access
        // This is a placeholder - in production, you'd need JS interop
        await Task.CompletedTask;
    }

    private bool IsOtpComplete()
    {
        return otp.All(digit => !string.IsNullOrEmpty(digit));
    }

    private async Task HandleSubmit()
    {
        if (!IsOtpComplete())
        {
            return;
        }

        if (isExpired)
        {
            Array.Clear(otp, 0, otp.Length);
            return;
        }

        var otpCode = string.Join("", otp);
        var response = await AuthService.VerifyOtpAsync(email ?? "", otpCode, isActivation);

        if (response == null)
        {
            ToastService.ShowError(AuthService.ErrorMessage);
            Array.Clear(otp, 0, otp.Length);
            return;
        }

        if (response.StatusCode != 200)
        {
            ToastService.ShowError(response.Message);
            Array.Clear(otp, 0, otp.Length);
            return;
        }

        if (!isActivation)
        {
            Navigation.NavigateTo($"/auth/reset-password?email={Uri.EscapeDataString(email ?? "")}");
        }
        else
        {
            ToastService.ShowSuccess("Xác thực tài khoản thành công");
            Navigation.NavigateTo("/auth/login");
        }
    }

    private async Task HandleResend()
    {
        var response = await AuthService.SendOtpAsync(email ?? "");

        if (response != null && response.StatusCode == 200)
        {
            ToastService.ShowSuccess("Mã OTP đã được gửi lại");
            Array.Clear(otp, 0, otp.Length);
            timeLeft = 300;
            isExpired = false;

            if (timer != null)
            {
                timer.Start();
            }
        }
        else
        {
            ToastService.ShowError(AuthService.ErrorMessage);
        }
    }

    public void Dispose()
    {
        timer?.Stop();
        timer?.Dispose();
    }
}