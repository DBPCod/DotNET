@page "/auth/forgot-password"
@layout AuthLayout
@using Frontend.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject Blazored.Toast.Services.IToastService ToastService

<div class="auth-header">
    <h1 class="auth-title">Quên mật khẩu</h1>
    <p class="auth-subtitle">Nhập email của bạn và chúng tôi sẽ gửi mã OTP để giúp bạn cài lại mật khẩu mới</p>
</div>

<form class="auth-form" @onsubmit="HandleSubmit">
    <div class="form-group">
        <label class="form-label" for="email">Email</label>
        <div class="form-input-wrapper">
            <svg class="form-input-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <input class="form-input" id="email" type="email" placeholder="Nhập email của bạn" @bind="email"
                @oninput="ClearError" />
        </div>
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="form-error">@error</div>
        }
    </div>

    <button type="submit" class="btn btn-primary" disabled="@AuthService.IsLoading">
        @if (AuthService.IsLoading)
        {
            <svg class="btn-icon spinner" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
            </svg>
            <span>Đang gửi...</span>
        }
        else
        {
            <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m22 2-7 20-4-9-9-4Z"></path>
                <path d="M22 2 11 13"></path>
            </svg>
            <span>Gửi mã OTP</span>
        }
    </button>
</form>

<div style="text-align: center; margin-top: 1.5rem;">
    <a href="/auth/login" class="auth-back-link">
        <svg class="auth-back-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
        </svg>
        Quay lại trang đăng nhập
    </a>
</div>

@code {
    private string email = "";
    private string error = "";

    private void ClearError()
    {
        error = "";
    }

    private bool Validate()
    {
        error = "";

        if (string.IsNullOrWhiteSpace(email))
        {
            error = "Email là bắt buộc";
            return false;
        }

        if (!IsValidEmail(email))
        {
            error = "Vui lòng nhập email hợp lệ";
            return false;
        }

        return true;
    }

    private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }

    private async Task HandleSubmit()
    {
        if (!Validate())
        {
            return;
        }

        var response = await AuthService.SendOtpAsync(email);

        if (response == null)
        {
            ToastService.ShowError(AuthService.ErrorMessage);
            return;
        }

        if (response.StatusCode == 200)
        {
            ToastService.ShowSuccess("Đã gửi mã OTP về email của bạn");
            Navigation.NavigateTo($"/auth/verification?email={Uri.EscapeDataString(email)}&isActivation=false");
            return;
        }

        ToastService.ShowError(response.Message);
    }
}