@page "/auth/login"
@layout AuthLayout
@using Frontend.Services
@using Frontend.Models.Auth
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject Blazored.Toast.Services.IToastService ToastService

<div class="auth-header">
    <h1 class="auth-title">Đăng nhập</h1>
    <p class="auth-subtitle">Nhập thông tin để truy cập tài khoản của bạn</p>
</div>

<form class="auth-form" @onsubmit="HandleSubmit">
    <div class="form-group">
        <label class="form-label" for="email">Email hoặc Username</label>
        <div class="form-input-wrapper">
            <svg class="form-input-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <input class="form-input" id="email" type="text" placeholder="Nhập email hoặc username của bạn"
                @bind="formData.Email" @oninput="() => ClearError(nameof(formData.Email))" />
        </div>
        @if (errors.ContainsKey(nameof(formData.Email)))
        {
            <div class="form-error">@errors[nameof(formData.Email)]</div>
        }
    </div>

    <div class="form-group">
        <label class="form-label" for="password">Mật khẩu</label>
        <div class="form-input-wrapper">
            <svg class="form-input-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <input class="form-input" id="password" type="@(showPassword ? "text" : "password")"
                placeholder="Nhập mật khẩu của bạn" @bind="formData.Password"
                @oninput="() => ClearError(nameof(formData.Password))" />
            <svg class="form-input-icon-right" @onclick="TogglePassword" xmlns="http://www.w3.org/2000/svg" width="24"
                height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                @if (showPassword)
                {
                    <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                    <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                    <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                    <line x1="2" x2="22" y1="2" y2="22"></line>
                }
                else
                {
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                }
            </svg>
        </div>
        @if (errors.ContainsKey(nameof(formData.Password)))
        {
            <div class="form-error">@errors[nameof(formData.Password)]</div>
        }
    </div>

    @* <div style="display: flex; justify-content: flex-end;">
        <a href="/auth/forgot-password" style="font-size: 0.875rem; color: #4f46e5; text-decoration: none;">
            Quên mật khẩu?
        </a>
    </div> *@

    <button type="submit" class="btn btn-primary" disabled="@AuthService.IsLoading">
        @if (AuthService.IsLoading)
        {
            <svg class="btn-icon spinner" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
            </svg>
            <span>Đang đăng nhập...</span>
        }
        else
        {
            <span>Đăng nhập</span>
        }
    </button>
</form>

<div class="auth-link">
    Chưa có tài khoản?
    <a href="/auth/register">Đăng ký ngay</a>
</div>

@code {
    private class FormData
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    private FormData formData = new();
    private Dictionary<string, string> errors = new();
    private bool showPassword = false;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        if (AuthService.CurrentUser != null)
        {
            Navigation.NavigateTo("/");
            return;
        }
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private void ClearError(string field)
    {
        if (errors.ContainsKey(field))
        {
            errors.Remove(field);
        }
    }

    private bool Validate()
    {
        errors.Clear();

        if (string.IsNullOrWhiteSpace(formData.Email))
        {
            errors[nameof(formData.Email)] = "Email hoặc Username là bắt buộc";
        }

        if (string.IsNullOrWhiteSpace(formData.Password))
        {
            errors[nameof(formData.Password)] = "Mật khẩu là bắt buộc";
        }

        return errors.Count == 0;
    }

    private async Task HandleSubmit()
    {
        if (!Validate())
        {
            return;
        }

        var response = await AuthService.LoginAsync(formData.Email, formData.Password);

        if (response == null)
        {
            ToastService.ShowError(AuthService.ErrorMessage);
            return;
        }
        Console.WriteLine("Response StatusCode: " + response.StatusCode);

        if (response.StatusCode == 401)
        {
            ToastService.ShowError("Thông tin đăng nhập không hợp lệ");
            return;
        }

        if (response.StatusCode == 403)
        {
            Navigation.NavigateTo("/auth/banned");
            return;
        }

        if (response.StatusCode == 423)
        {
            Navigation.NavigateTo($"/auth/verification?email={Uri.EscapeDataString(formData.Email)}&isActivation=true");
            await AuthService.SendOtpAsync(formData.Email);
            return;
        }

        if (response.StatusCode == 200)
        {
            ToastService.ShowSuccess("Đăng nhập thành công!");
            Navigation.NavigateTo("/");
            return;
        }

        ToastService.ShowError(response.Message);
    }
}