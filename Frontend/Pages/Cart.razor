@page "/cart"
@using Frontend.Services
@using Frontend.Models.Common
@inject CartService CartService
@inject NavigationManager NavigationManager
@inject InventoryService InventoryService
@inject Blazored.Toast.Services.IToastService ToastService
@inject IJSRuntime JSRuntime

<PageTitle>Giỏ hàng</PageTitle>

<div class="cart-page">
    <h2>Giỏ hàng của bạn</h2>

    @if (CartService.Items == null || !CartService.Items.Any())
    {
        <div class="alert alert-info mt-4">
            Giỏ hàng đang trống. Hãy quay lại <a href="/">trang chủ</a> để chọn sản phẩm.
        </div>
    }
    else
    {
        <div class="table-responsive mt-4 cart-table-wrapper">
            <table class="table align-middle cart-table">
                <thead>
                    <tr>
                        <th class="cart-col-image">Ảnh</th>
                        <th class="cart-col-product">Sản phẩm</th>
                        <th class="cart-col-price text-end">Đơn giá</th>
                        <th class="cart-col-quantity text-center">Số lượng</th>
                        <th class="cart-col-total text-end">Thành tiền</th>
                        <th class="cart-col-action"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in CartService.Items)
                    {
                        <tr>
                            <td class="cart-col-image">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img class="cart-item-image" src="@GetImageUrl(item.ImagePath)" alt="@item.ProductName" />
                                }
                                else
                                {
                                    <div class="cart-item-image-placeholder">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                            </td>
                            <td class="cart-col-product">
                                <span class="fw-semibold">@item.ProductName</span>
                                <br />
                                @{
                                    var stock = GetStock(item.ProductId);
                                }
                                @if (stock > 0)
                                {
                                    <small class="text-success">
                                        <i class="bi bi-check-circle"></i> Còn @stock sản phẩm
                                    </small>
                                }
                                else
                                {
                                    <small class="text-muted">Đang kiểm tra tồn kho...</small>
                                }
                            </td>
                            <td class="cart-col-price text-end">@item.UnitPrice.ToString("N0") VNĐ</td>
                            <td class="cart-col-quantity text-center">
                                <div class="quantity-controls">
                                    <button class="btn btn-sm btn-outline-secondary quantity-btn" 
                                            @onclick="() => DecreaseQuantity(item.ProductId)"
                                            disabled="@(item.Quantity <= 1)">
                                        <i class="bi bi-dash"></i>
                                    </button>
                                    <input type="number" 
                                           class="quantity-input" 
                                           min="1" 
                                           max="@GetStock(item.ProductId)"
                                           value="@item.Quantity"
                                           @oninput="(e => OnQuantityInputChanged(item.ProductId, e.Value?.ToString()))"
                                           @onblur="(e => OnQuantityBlur(item.ProductId))" />
                                    <button class="btn btn-sm btn-outline-secondary quantity-btn" 
                                            @onclick="() => IncreaseQuantity(item.ProductId)"
                                            disabled="@(GetStock(item.ProductId) > 0 && item.Quantity >= GetStock(item.ProductId))">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>
                                @if (!string.IsNullOrEmpty(GetQuantityError(item.ProductId)))
                                {
                                    <small class="text-danger d-block mt-1">
                                        <i class="bi bi-exclamation-circle"></i> @GetQuantityError(item.ProductId)
                                    </small>
                                }
                            </td>
                            <td class="cart-col-total text-end fw-semibold">@item.Total.ToString("N0") VNĐ</td>
                            <td class="cart-col-action text-end">
                                <button class="btn btn-sm btn-outline-danger" @onclick="@(() => Remove(item.ProductId))">
                                    <i class="bi bi-x"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="cart-summary mt-4 d-flex justify-content-between align-items-center">
            <div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="Clear">
                    Xóa hết
                </button>
            </div>
            <div class="text-end">
                <div class="fw-semibold mb-2">
                    Tổng tiền: <span class="text-danger">@CartService.GetTotal().ToString("N0") VNĐ</span>
                </div>
                <button class="btn btn-primary" @onclick="GoToOrder">
                    Đặt hàng ngay
                </button>
            </div>
        </div>
    }
</div>

@code {
    private Dictionary<string, int> productInventories = new();
    private Dictionary<string, string> quantityErrors = new();

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        await LoadInventories();
    }

    private async Task LoadInventories()
    {
        if (CartService.Items == null || !CartService.Items.Any())
            return;

        foreach (var item in CartService.Items)
        {
            try
            {
                var inventoryResponse = await InventoryService.GetInventoryByProductIdAsync(item.ProductId);
                if (inventoryResponse?.StatusCode == 200 && inventoryResponse.Data?.Inventory != null)
                {
                    productInventories[item.ProductId] = inventoryResponse.Data.Inventory.Quantity;
                }
                else
                {
                    productInventories[item.ProductId] = 0;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading inventory for {item.ProductId}: {ex.Message}");
                productInventories[item.ProductId] = 0;
            }
        }
        StateHasChanged();
    }


    private void Remove(string productId) => CartService.Remove(productId);

    private void Clear() => CartService.Clear();

    private void GoToOrder() => NavigationManager.NavigateTo("/orders");

    private int GetStock(string productId)
    {
        return productInventories.TryGetValue(productId, out var stock) ? stock : 0;
    }

    private string GetQuantityError(string productId)
    {
        return quantityErrors.TryGetValue(productId, out var error) ? error : "";
    }

    private void OnQuantityInputChanged(string productId, string? value)
    {
        quantityErrors.Remove(productId);
        
        // Validation 1: Kiểm tra có phải số không
        if (string.IsNullOrWhiteSpace(value) || !int.TryParse(value, out var quantity))
        {
            // Chưa nhập xong, chỉ hiển thị cảnh báo nhẹ
            quantityErrors[productId] = "Vui lòng nhập số";
            StateHasChanged();
            return;
        }

        // Validation 2: Kiểm tra số dương
        if (quantity <= 0)
        {
            quantityErrors[productId] = "Số lượng phải lớn hơn 0";
            StateHasChanged();
            return;
        }

        // Validation 3: Kiểm tra tồn kho
        var stock = GetStock(productId);
        if (stock > 0 && quantity > stock)
        {
            quantityErrors[productId] = $"Chỉ còn {stock} sản phẩm trong kho!";
            StateHasChanged();
            return;
        }

        // Validation OK - Xóa lỗi và cập nhật số lượng
        quantityErrors.Remove(productId);
        CartService.UpdateQuantity(productId, quantity, stock > 0 ? stock : null);
        StateHasChanged();
    }

    private void OnQuantityBlur(string productId)
    {
        var item = CartService.Items.FirstOrDefault(x => x.ProductId == productId);
        if (item == null) return;

        var stock = GetStock(productId);
        
        // Khi blur, kiểm tra và tự động sửa giá trị không hợp lệ
        if (item.Quantity <= 0)
        {
            ToastService.ShowError("Số lượng phải lớn hơn 0. Đã tự động đặt về 1.");
            CartService.UpdateQuantity(productId, 1);
            quantityErrors.Remove(productId);
            StateHasChanged();
        }
        else if (stock > 0 && item.Quantity > stock)
        {
            ToastService.ShowError($"Số lượng vượt quá tồn kho! Chỉ còn {stock} sản phẩm. Đã tự động điều chỉnh.");
            CartService.UpdateQuantity(productId, stock);
            quantityErrors.Remove(productId);
            StateHasChanged();
        }
        else
        {
            // Giá trị hợp lệ, xóa lỗi
            quantityErrors.Remove(productId);
            StateHasChanged();
        }
    }

    private async void IncreaseQuantity(string productId)
    {
        quantityErrors.Remove(productId);
        var item = CartService.Items.FirstOrDefault(x => x.ProductId == productId);
        if (item == null) return;

        var stock = GetStock(productId);
        if (stock > 0 && item.Quantity >= stock)
        {
            quantityErrors[productId] = $"Đạt tối đa {stock}";
            ToastService.ShowWarning($"Không thể thêm. Chỉ còn {stock} sản phẩm trong kho!");
            StateHasChanged();
            return;
        }

        bool updated = CartService.UpdateQuantity(productId, item.Quantity + 1, stock > 0 ? stock : null);
        if (!updated)
        {
            quantityErrors[productId] = $"Tồn kho: {stock}";
            ToastService.ShowError($"Không thể tăng số lượng. Tồn kho: {stock}");
        }
        StateHasChanged();
    }

    private void DecreaseQuantity(string productId)
    {
        quantityErrors.Remove(productId);
        var item = CartService.Items.FirstOrDefault(x => x.ProductId == productId);
        if (item == null) return;

        if (item.Quantity > 1)
        {
            CartService.UpdateQuantity(productId, item.Quantity - 1);
            StateHasChanged();
        }
    }

    private string GetImageUrl(string imagePath)
        => $"http://localhost:4040/{imagePath.TrimStart('/')}";
}

<style>
    .cart-page h2 {
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .cart-table-wrapper {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
    }

    .cart-table {
        margin-bottom: 0;
    }

    .cart-table thead {
        background-color: #f9fafb;
    }

    .cart-table thead th {
        border-bottom: 2px solid #e5e7eb;
        font-weight: 600;
        padding: 1rem 0.75rem;
        white-space: nowrap;
    }

    .cart-table tbody td {
        padding: 1rem 0.75rem;
        vertical-align: middle;
    }

    .cart-col-image {
        width: 80px;
        min-width: 80px;
    }

    .cart-col-product {
        min-width: 200px;
    }

    .cart-col-price {
        width: 120px;
        min-width: 120px;
    }

    .cart-col-quantity {
        width: 120px;
        min-width: 120px;
    }

    .cart-col-total {
        width: 140px;
        min-width: 140px;
    }

    .cart-col-action {
        width: 60px;
        min-width: 60px;
    }

    .cart-item-image {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
    }

    .cart-item-image-placeholder {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f3f4f6;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
        color: #9ca3af;
        font-size: 1.5rem;
    }

    .quantity-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .quantity-btn {
        width: 32px;
        height: 32px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        transition: all 0.2s;
    }

    .quantity-btn:not(:disabled):hover {
        background-color: #667eea;
        border-color: #667eea;
        color: white;
        transform: scale(1.1);
    }

    .quantity-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .quantity-input {
        width: 60px;
        text-align: center;
        font-weight: 600;
        font-size: 1rem;
        border: 2px solid #e5e7eb;
        border-radius: 6px;
        padding: 0.35rem 0.25rem;
        background-color: #ffffff;
        transition: all 0.2s;
        outline: none;
    }

    .quantity-input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .quantity-input::-webkit-inner-spin-button,
    .quantity-input::-webkit-outer-spin-button {
        opacity: 1;
        height: 24px;
    }

    /* Firefox */
    .quantity-input[type="number"] {
        -moz-appearance: textfield;
    }

    .quantity-input:hover::-webkit-inner-spin-button,
    .quantity-input:hover::-webkit-outer-spin-button {
        opacity: 1;
    }

    .cart-summary {
        padding-top: 1rem;
        border-top: 1px solid #e5e7eb;
    }

    @@media (max-width: 768px) {
        .cart-table-wrapper {
            overflow-x: auto;
        }

        .cart-table {
            min-width: 700px;
        }
    }
</style>


