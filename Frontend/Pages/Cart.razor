@page "/cart"
@using Frontend.Services
@using Frontend.Models.Common
@inject CartService CartService
@inject NavigationManager NavigationManager

<PageTitle>Giỏ hàng</PageTitle>

<div class="cart-page">
    <h2>Giỏ hàng của bạn</h2>

    @if (CartService.Items == null || !CartService.Items.Any())
    {
        <div class="alert alert-info mt-4">
            Giỏ hàng đang trống. Hãy quay lại <a href="/">trang chủ</a> để chọn sản phẩm.
        </div>
    }
    else
    {
        <div class="table-responsive mt-4 cart-table-wrapper">
            <table class="table align-middle cart-table">
                <thead>
                    <tr>
                        <th class="cart-col-image">Ảnh</th>
                        <th class="cart-col-product">Sản phẩm</th>
                        <th class="cart-col-price text-end">Đơn giá</th>
                        <th class="cart-col-quantity text-center">Số lượng</th>
                        <th class="cart-col-total text-end">Thành tiền</th>
                        <th class="cart-col-action"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in CartService.Items)
                    {
                        <tr>
                            <td class="cart-col-image">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img class="cart-item-image" src="@GetImageUrl(item.ImagePath)" alt="@item.ProductName" />
                                }
                                else
                                {
                                    <div class="cart-item-image-placeholder">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                            </td>
                            <td class="cart-col-product">
                                <span class="fw-semibold">@item.ProductName</span>
                            </td>
                            <td class="cart-col-price text-end">@item.UnitPrice.ToString("N0") VNĐ</td>
                            <td class="cart-col-quantity text-center">
                                <input type="number" min="1" class="form-control form-control-sm quantity-input"
                                       value="@item.Quantity"
                                       @onchange="(e => OnQuantityChanged(item.ProductId, e.Value?.ToString()))" />
                            </td>
                            <td class="cart-col-total text-end fw-semibold">@item.Total.ToString("N0") VNĐ</td>
                            <td class="cart-col-action text-end">
                                <button class="btn btn-sm btn-outline-danger" @onclick="@(() => Remove(item.ProductId))">
                                    <i class="bi bi-x"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="cart-summary mt-4 d-flex justify-content-between align-items-center">
            <div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="Clear">
                    Xóa hết
                </button>
            </div>
            <div class="text-end">
                <div class="fw-semibold mb-2">
                    Tổng tiền: <span class="text-danger">@CartService.GetTotal().ToString("N0") VNĐ</span>
                </div>
                <button class="btn btn-primary" @onclick="GoToOrder">
                    Đặt hàng ngay
                </button>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    private void Remove(string productId) => CartService.Remove(productId);

    private void Clear() => CartService.Clear();

    private void GoToOrder() => NavigationManager.NavigateTo("/orders");

    private void OnQuantityChanged(string productId, string? value)
    {
        if (int.TryParse(value, out var quantity))
        {
            CartService.UpdateQuantity(productId, quantity);
        }
    }

    private string GetImageUrl(string imagePath)
        => $"http://localhost:4040/{imagePath.TrimStart('/')}";
}

<style>
    .cart-page h2 {
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .cart-table-wrapper {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
    }

    .cart-table {
        margin-bottom: 0;
    }

    .cart-table thead {
        background-color: #f9fafb;
    }

    .cart-table thead th {
        border-bottom: 2px solid #e5e7eb;
        font-weight: 600;
        padding: 1rem 0.75rem;
        white-space: nowrap;
    }

    .cart-table tbody td {
        padding: 1rem 0.75rem;
        vertical-align: middle;
    }

    .cart-col-image {
        width: 80px;
        min-width: 80px;
    }

    .cart-col-product {
        min-width: 200px;
    }

    .cart-col-price {
        width: 120px;
        min-width: 120px;
    }

    .cart-col-quantity {
        width: 120px;
        min-width: 120px;
    }

    .cart-col-total {
        width: 140px;
        min-width: 140px;
    }

    .cart-col-action {
        width: 60px;
        min-width: 60px;
    }

    .cart-item-image {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
    }

    .cart-item-image-placeholder {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f3f4f6;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
        color: #9ca3af;
        font-size: 1.5rem;
    }

    .quantity-input {
        max-width: 100px;
        margin: 0 auto;
        text-align: center;
    }

    .cart-summary {
        padding-top: 1rem;
        border-top: 1px solid #e5e7eb;
    }

    @@media (max-width: 768px) {
        .cart-table-wrapper {
            overflow-x: auto;
        }

        .cart-table {
            min-width: 700px;
        }
    }
</style>


