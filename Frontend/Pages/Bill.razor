@page "/bill"
@using Frontend.Services
@inject CartService CartService
@inject NavigationManager NavigationManager

<PageTitle>Thông tin thanh toán</PageTitle>

<div class="bill-page text-center">
    <div class="bill-card">
        <div class="bill-icon">
            <i class="bi bi-check2-circle"></i>
        </div>
        <h2>Cảm ơn bạn đã đặt hàng!</h2>
        <p class="text-muted mb-4">
            Đơn hàng của bạn đã được tiếp nhận. Nhân viên sẽ liên hệ xác nhận và giao hàng trong thời gian sớm nhất.
        </p>

        <div class="bill-summary text-start">
            <div class="d-flex justify-content-between mb-2">
                <span>Tổng tiền đơn hàng</span>
                <span class="fw-semibold text-danger">@CartService.GetTotal().ToString("N0") VNĐ</span>
            </div>
            <div class="small text-muted">
                (Chi tiết sản phẩm vui lòng xem lại trong email hoặc lịch sử mua hàng khi tính năng hoàn thiện)
            </div>
        </div>

        <div class="mt-4 d-flex gap-2 justify-content-center">
            <button class="btn btn-outline-secondary" @onclick="BackToHome">
                Về trang chủ
            </button>
            <button class="btn btn-primary" @onclick="NewOrder">
                Đặt thêm đơn mới
            </button>
        </div>
    </div>
</div>

@code {
    private void BackToHome()
    {
        NavigationManager.NavigateTo("/");
    }

    private void NewOrder()
    {
        CartService.Clear();
        NavigationManager.NavigateTo("/");
    }
}

<style>
    .bill-page {
        display: flex;
        justify-content: center;
        padding-top: 2rem;
    }

    .bill-card {
        max-width: 520px;
        width: 100%;
        background: #ffffff;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.15);
    }

    .bill-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background-color: #ecfdf5;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #22c55e;
        font-size: 2rem;
        margin: 0 auto 1rem auto;
    }

    .bill-summary {
        padding: 1rem;
        border-radius: 8px;
        background-color: #f9fafb;
        border: 1px solid #e5e7eb;
    }
</style>


