@page "/orders"
@using Frontend.Services
@using Frontend.Models.Order
@using Frontend.Models.OrderItem
@using Frontend.Models.Customer
@using Frontend.Models.Promotions.Responses
@using System.ComponentModel.DataAnnotations
@inject CartService CartService
@inject NavigationManager NavigationManager
@inject OrderService OrderService
@inject OrderItemService OrderItemService
@inject AuthService AuthService
@inject CustomerService CustomerService
@inject PromotionService PromotionService
@inject Blazored.Toast.Services.IToastService ToastService

<PageTitle>Đặt hàng</PageTitle>

<div class="order-page">
    <h2>Thông tin đơn hàng</h2>

    @if (CartService.Items == null || !CartService.Items.Any())
    {
        <div class="alert alert-info mt-4">
            Giỏ hàng đang trống. Vui lòng quay lại <a href="/">trang chủ</a> để chọn sản phẩm.
        </div>
    }
    else if (AuthService.CurrentUser == null)
    {
        <div class="alert alert-warning mt-4">
            Vui lòng <a href="/auth/login">đăng nhập</a> để đặt hàng.
        </div>
    }
    else
    {
        <div class="row mt-4 g-4">
            <div class="col-md-7">
                <h5>Sản phẩm</h5>
                <ul class="list-group">
                    @foreach (var item in CartService.Items)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">@item.ProductName</div>
                                <small class="text-muted">Số lượng: @item.Quantity</small>
                            </div>
                            <span>@item.Total.ToString("N0") VNĐ</span>
                        </li>
                    }
                </ul>
            </div>

            <div class="col-md-5">
                <h5>Thông tin giao hàng</h5>
                <EditForm Model="@orderForm" OnValidSubmit="@HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                        <InputText class="form-control" 
                                   placeholder="Nhập họ tên của bạn" 
                                   @bind-Value="orderForm.CustomerName" />
                        <ValidationMessage For="@(() => orderForm.CustomerName)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <InputText class="form-control" 
                                   placeholder="Nhập số điện thoại" 
                                   @bind-Value="orderForm.CustomerPhone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ giao hàng</label>
                        <InputTextArea class="form-control" 
                                      rows="3" 
                                      placeholder="Nhập địa chỉ cụ thể" 
                                      @bind-Value="orderForm.CustomerAddress" />
                    </div>

                    <!-- Mã giảm giá -->
                    <div class="mb-3">
                        <label class="form-label">Mã giảm giá</label>
                        <div class="input-group">
                            <input type="text" 
                                   class="form-control" 
                                   placeholder="Nhập mã giảm giá" 
                                   value="@promoCode"
                                   @oninput="@(e => { promoCode = e.Value?.ToString() ?? ""; StateHasChanged(); })"
                                   disabled="@isValidatingPromo"
                                   @onkeypress="@(async (e) => { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(promoCode) && !isValidatingPromo) await ValidatePromoCode(); })" />
                            <button type="button" 
                                    class="btn btn-outline-primary" 
                                    @onclick="ValidatePromoCode"
                                    disabled="@(isValidatingPromo || string.IsNullOrWhiteSpace(promoCode))">
                                @if (isValidatingPromo)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                }
                                else
                                {
                                    <span>Áp dụng</span>
                                }
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(promoMessage))
                        {
                            <div class="mt-2">
                                @if (promoValidationResult?.Valid == true)
                                {
                                    <div class="alert alert-success mb-0 py-2">
                                        <i class="bi bi-check-circle me-2"></i>
                                        @promoMessage
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-danger mb-0 py-2">
                                        <i class="bi bi-x-circle me-2"></i>
                                        @promoMessage
                                    </div>
                                }
                            </div>
                        }
                        @if (appliedPromoId != null && promoValidationResult?.Valid == true)
                        {
                            <div class="mt-2">
                                <button type="button" 
                                        class="btn btn-sm btn-outline-danger" 
                                        @onclick="RemovePromoCode">
                                    <i class="bi bi-x me-1"></i> Xóa mã
                                </button>
                            </div>
                        }
                    </div>

                    <div class="order-summary">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tổng tiền hàng</span>
                            <span>@CartService.GetTotal().ToString("N0") VNĐ</span>
                        </div>
                        @if (appliedDiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Giảm giá</span>
                                <span>-@appliedDiscountAmount.ToString("N0") VNĐ</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển</span>
                            <span>0 VNĐ</span>
                        </div>
                        <div class="d-flex justify-content-between fw-semibold border-top pt-2">
                            <span>Thành tiền</span>
                            <span class="text-danger">@GetFinalTotal().ToString("N0") VNĐ</span>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger mt-3 mb-0">
                                @errorMessage
                            </div>
                        }

                        <button type="submit" class="btn btn-primary w-100 mt-3" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Đang xử lý...</span>
                            }
                            else
                            {
                                <span>Xác nhận đặt hàng</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private OrderForm orderForm = new();
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;
    
    // Promotion code
    private string promoCode = "";
    private bool isValidatingPromo = false;
    private string promoMessage = "";
    private ValidatePromotionResponse? promoValidationResult = null;
    private Guid? appliedPromoId = null;
    private decimal appliedDiscountAmount = 0;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        
        // Pre-fill form với thông tin user nếu có
        if (AuthService.CurrentUser != null)
        {
            orderForm.CustomerName = AuthService.CurrentUser.FullName ?? AuthService.CurrentUser.Username ?? "";
            
            // Load thông tin Customer từ database (phone, address) nếu có
            await LoadCustomerInfo();
        }
    }

    private async Task LoadCustomerInfo()
    {
        if (AuthService.CurrentUser == null || string.IsNullOrEmpty(AuthService.CurrentUser.Email))
            return;

        try
        {
            // Tìm Customer theo email bằng cách search
            var response = await CustomerService.GetCustomersAsync(page: 1, pageSize: 1, q: AuthService.CurrentUser.Email);
            if (response != null && response.StatusCode == 200 && response.Data?.Customers != null && response.Data.Customers.Any())
            {
                var customer = response.Data.Customers.FirstOrDefault(c => 
                    !string.IsNullOrEmpty(c.Email) && 
                    c.Email.Equals(AuthService.CurrentUser.Email, StringComparison.OrdinalIgnoreCase));
                
                if (customer != null)
                {
                    // Pre-fill phone và address nếu có
                    if (!string.IsNullOrEmpty(customer.Phone))
                        orderForm.CustomerPhone = customer.Phone;
                    if (!string.IsNullOrEmpty(customer.Address))
                        orderForm.CustomerAddress = customer.Address;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customer info: {ex.Message}");
            // Không hiển thị lỗi cho user, chỉ log
        }
    }


    private async Task HandleSubmit()
    {
        if (isSubmitting) return;

        // Validate
        if (AuthService.CurrentUser == null)
        {
            ToastService.ShowError("Vui lòng đăng nhập để đặt hàng");
            NavigationManager.NavigateTo("/auth/login");
            return;
        }

        if (CartService.Items == null || !CartService.Items.Any())
        {
            ToastService.ShowError("Giỏ hàng đang trống");
            return;
        }

        isSubmitting = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            // Bước 1: Tạo Order
            var totalAmount = CartService.GetTotal();
            
            if (!Guid.TryParse(AuthService.CurrentUser.Id, out var userId))
            {
                errorMessage = "Lỗi: User ID không hợp lệ";
                ToastService.ShowError(errorMessage);
                return;
            }
            
            var orderRequest = new CreateOrderRequest
            {
                CustomerId = null, // Sẽ tự động lấy từ User email
                UserId = userId,
                PromoId = appliedPromoId, // Sử dụng mã giảm giá đã áp dụng
                TotalAmount = totalAmount,
                DiscountAmount = appliedDiscountAmount, // Số tiền giảm giá
                CustomerName = orderForm.CustomerName,
                CustomerPhone = orderForm.CustomerPhone,
                CustomerAddress = orderForm.CustomerAddress
            };

            var orderResponse = await OrderService.CreateOrderAsync(orderRequest);
            
            if (orderResponse == null || (orderResponse.StatusCode != 200 && orderResponse.StatusCode != 201) || orderResponse.Data == null)
            {
                errorMessage = $"Lỗi tạo đơn hàng: {orderResponse?.Message ?? "Unknown error"}";
                ToastService.ShowError(errorMessage);
                return;
            }

            var orderIdStr = orderResponse.Data.order?.Id;
            if (string.IsNullOrEmpty(orderIdStr) || !Guid.TryParse(orderIdStr, out var newOrderId))
            {
                errorMessage = "Lỗi: Mã đơn hàng không hợp lệ";
                ToastService.ShowError(errorMessage);
                return;
            }

            // Bước 2: Tạo Order Items
            var orderItems = CartService.Items.Select(item => new OrderItemInput
            {
                ProductId = Guid.Parse(item.ProductId),
                Quantity = item.Quantity
            }).ToList();

            var itemsRequest = new CreateOrderItemsRequest
            {
                OrderId = newOrderId,
                Items = orderItems
            };

            var itemsResponse = await OrderItemService.CreateOrderItemsAsync(itemsRequest);
            
            if (itemsResponse == null || (itemsResponse.StatusCode != 200 && itemsResponse.StatusCode != 201))
            {
                errorMessage = $"Lỗi tạo chi tiết đơn hàng: {itemsResponse?.Message ?? "Unknown error"}";
                ToastService.ShowError(errorMessage);
                return;
            }
            
            // Kiểm tra xem có order items được tạo không
            if (itemsResponse.Data?.OrderItems == null || !itemsResponse.Data.OrderItems.Any())
            {
                errorMessage = "Không thể tạo chi tiết đơn hàng";
                ToastService.ShowError(errorMessage);
                return;
            }

            // Thành công: Clear cart và redirect
            CartService.Clear();
            ToastService.ShowSuccess("Đặt hàng thành công!");
            NavigationManager.NavigateTo($"/bill?orderId={newOrderId}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi: {ex.Message}";
            ToastService.ShowError(errorMessage);
            Console.WriteLine($"Error creating order: {ex}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task ValidatePromoCode()
    {
        if (string.IsNullOrWhiteSpace(promoCode))
        {
            promoMessage = "Vui lòng nhập mã giảm giá";
            return;
        }

        isValidatingPromo = true;
        promoMessage = "";
        StateHasChanged();

        try
        {
            var totalAmount = CartService.GetTotal();
            var validationResult = await PromotionService.ValidatePromotionAsync(promoCode.Trim().ToUpper(), totalAmount);

            if (validationResult != null && validationResult.Valid && !string.IsNullOrEmpty(validationResult.PromotionId))
            {
                if (Guid.TryParse(validationResult.PromotionId, out var promoId))
                {
                    appliedPromoId = promoId;
                }
                else
                {
                    promoMessage = "Lỗi: Mã giảm giá không hợp lệ";
                    ToastService.ShowError(promoMessage);
                    return;
                }
                
                appliedDiscountAmount = validationResult.DiscountAmount;
                promoValidationResult = validationResult;
                
                var discountText = validationResult.DiscountType switch
                {
                    "percent" => $"{validationResult.DiscountAmount:N0} VNĐ",
                    "fixed" => $"{validationResult.DiscountAmount:N0} VNĐ",
                    "free_shipping" => "Miễn phí vận chuyển",
                    _ => $"{validationResult.DiscountAmount:N0} VNĐ"
                };
                
                promoMessage = $"Áp dụng mã giảm giá thành công! Giảm: {discountText}";
                ToastService.ShowSuccess("Áp dụng mã giảm giá thành công!");
            }
            else
            {
                appliedPromoId = null;
                appliedDiscountAmount = 0;
                promoValidationResult = validationResult;
                
                var reasonText = validationResult?.Reason switch
                {
                    "not_found" => "Mã giảm giá không tồn tại",
                    "inactive" => "Mã giảm giá đã bị vô hiệu hóa",
                    "expired" => "Mã giảm giá đã hết hạn hoặc chưa có hiệu lực",
                    "min_order" => "Đơn hàng chưa đạt giá trị tối thiểu",
                    "usage_limit" => "Mã giảm giá đã hết lượt sử dụng",
                    _ => "Mã giảm giá không hợp lệ"
                };
                
                promoMessage = reasonText;
                ToastService.ShowError(reasonText);
            }
        }
        catch (Exception ex)
        {
            promoMessage = $"Lỗi khi kiểm tra mã giảm giá: {ex.Message}";
            ToastService.ShowError(promoMessage);
            appliedPromoId = null;
            appliedDiscountAmount = 0;
            promoValidationResult = null;
        }
        finally
        {
            isValidatingPromo = false;
            StateHasChanged();
        }
    }

    private void RemovePromoCode()
    {
        promoCode = "";
        appliedPromoId = null;
        appliedDiscountAmount = 0;
        promoValidationResult = null;
        promoMessage = "";
        StateHasChanged();
    }

    private decimal GetFinalTotal()
    {
        var total = CartService.GetTotal();
        return Math.Max(0, total - appliedDiscountAmount);
    }

    public class OrderForm
    {
        [Required(ErrorMessage = "Họ và tên là bắt buộc")]
        [MinLength(2, ErrorMessage = "Họ và tên phải có ít nhất 2 ký tự")]
        public string CustomerName { get; set; } = string.Empty;

        public string? CustomerPhone { get; set; }

        public string? CustomerAddress { get; set; }
    }
}

<style>
    .order-page h2 {
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .order-summary {
        padding: 1rem;
        border-radius: 8px;
        background-color: #f9fafb;
        border: 1px solid #e5e7eb;
    }
</style>


